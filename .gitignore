# Variáveis de ambiente e credenciais
.env
.env.*
!.env.example

# Ambientes virtuais Python
.venv/
venv/
env/

# Cache e artefatos Python
__pycache__/
*.pyc
*.pyo
*.pyd
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Dados locais — nunca versionar datasets RAW ou processados
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/raw/README.md
!data/processed/README.md

# Arquivos locais de banco e logs
*.db
*.sqlite
*.sqlite3
*.log

# Sistema operacional e IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Artefatos locais do Power BI
*.pbix
*.pbit